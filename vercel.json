{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/health", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [{ "path": "/api/cron/refresh", "schedule": "0 3 * * *" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
