# Postgres hospedado (Vercel Postgres, Neon, etc).
# DATABASE_URL = connection string "pooled" (usada em runtime pela API/funcao serverless)
# DIRECT_URL   = connection string direta/sem pool (usada so para rodar migrations)
# Em dev local sem um Postgres hospedado, aponte as duas para o mesmo banco.
DATABASE_URL=""
DIRECT_URL=""

PORT=3000

# Usado apenas quando rodando localmente via "npm run dev" (src/index.ts).
# Na Vercel, quem dispara a coleta diaria e o Cron Job configurado em vercel.json.
CRON_SCHEDULE="0 3 * * *"

# Obrigatorio na Vercel: protege a rota /api/cron/refresh para que só o
# proprio Vercel Cron consiga chama-la. A Vercel injeta automaticamente o
# header "Authorization: Bearer <CRON_SECRET>" nas chamadas de cron quando
# essa variavel esta configurada no projeto. Gere um valor aleatorio.
CRON_SECRET=

# Protege as rotas /api/profiles/* (GET, POST, DELETE) para que apenas quem
# tiver essa chave consiga usar a API - necessario se outro projeto for
# consumir esta API. Enviar como header: "Authorization: Bearer <API_KEY>".
# Se ficar vazio, as rotas ficam sem autenticacao (ok so para dev local).
API_KEY=

# Opcional: cookie de sessao do Instagram (par "sessionid=...") para reduzir
# a chance de bloqueio/rate-limit do scraper. Deixe vazio para usar sem login.
IG_SESSION_COOKIE=
